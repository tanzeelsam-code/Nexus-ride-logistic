{
  "name": "nexus-api",
  "version": "1.0.0",
  "description": "NEXUS Logistics Backend API",
  "main": "backend_api.js",
  "scripts": {
    "start": "node backend_api.js",
    "smoke": "bash scripts/smoke-check.sh",
    "verify": "bash scripts/verify-all.sh",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "preview:cloudflare": "wrangler dev",
    "build:apk": "bash scripts/build-apk.sh",
    "install:apk": "adb install -r dist/nexus-logistics.apk",
    "launch:apk": "adb shell am start -n com.nexus.logistics/.MainActivity",
    "test": "node scripts/e2e.js",
    "test:e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "^8.16.1",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.7.2",
    "stripe": "^14.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "wrangler": "^4.147.0"
  }
}
