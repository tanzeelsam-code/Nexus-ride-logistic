{
  "name": "nexora-api",
  "version": "1.0.0",
  "description": "NEXORA Logistics Backend API",
  "main": "backend_api.js",
  "scripts": {
    "start": "node backend_api.js",
    "smoke": "bash scripts/smoke-check.sh",
    "verify": "bash scripts/verify-all.sh",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "preview:cloudflare": "node --env-file=.env.cloudflare-local node_modules/wrangler/bin/wrangler.js dev",
    "build:apk": "bash scripts/build-apk.sh",
    "install:apk": "adb install -r dist/nexora-logistics.apk",
    "launch:apk": "adb shell am start -n com.nexora.logistics/.MainActivity",
    "test": "node scripts/e2e.js",
    "test:workspace": "node --test scripts/workspace-session.test.cjs",
    "test:e2e": "node scripts/e2e.js",
    "test:integrations": "node --test scripts/integrations.test.cjs scripts/customer-session.test.cjs scripts/payments-integration.test.cjs scripts/release-integration.test.cjs",
    "test:ai": "python3 -m unittest discover -s scripts -p \"test_ai_baseline.py\"",
    "test:ui": "node --test scripts/booking-ui.test.cjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "10.2.3",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "axios": "^1.6.0",
    "bcryptjs": "3.0.3",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "^8.16.1",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.7.2",
    "stripe": "^14.0.0",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "socket.io-client": "^4.8.4",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "find-my-way": "9.9.0",
    "avvio": "9.3.0",
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25"
  }
}
