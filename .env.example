DB_PASSWORD=replace_with_your_value
REDIS_PASSWORD=replace_with_your_value
JWT_SECRET=replace_with_your_value
STRIPE_SECRET_KEY=replace_with_your_value
STRIPE_WEBHOOK_SECRET=replace_with_your_value
MAPBOX_API_KEY=replace_with_your_value
ANTHROPIC_API_KEY=replace_with_your_value
WEATHER_API_KEY=replace_with_your_value
GRAFANA_PASSWORD=replace_with_your_value

# --- Added: runtime settings used by the API (see README) ---------------------
# Comma-separated browser origins allowed by CORS (required when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost
# Admin account created/reset at API startup (password: 12+ chars). No default admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Shared key IoT cold-chain sensors send in the x-device-key header
IOT_DEVICE_KEY=
# Use "development" for local docker runs with Stripe test keys; production rejects sk_test_ keys
NODE_ENV=production

# --- Database connection (defaults target the local docker-compose Postgres) --
# For Supabase use the Session pooler values from Dashboard > Connect, e.g.:
#   DB_HOST=aws-0-<region>.pooler.supabase.com  DB_PORT=5432
#   DB_USER=postgres.ftghshvmcjxkshoenpmn       DB_NAME=postgres
#   DB_SSL=true                                  DB_CONNECT_TIMEOUT_MS=10000
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=2000
