DB_PASSWORD=replace_with_your_value
REDIS_PASSWORD=replace_with_your_value
JWT_SECRET=replace_with_your_value
STRIPE_SECRET_KEY=replace_with_your_value
STRIPE_WEBHOOK_SECRET=replace_with_your_value
MAPBOX_API_KEY=replace_with_your_value
ANTHROPIC_API_KEY=replace_with_your_value
WEATHER_API_KEY=replace_with_your_value
GRAFANA_PASSWORD=replace_with_your_value

# --- Added: runtime settings used by the API (see README) ---------------------
# Comma-separated browser origins allowed by CORS (required when NODE_ENV=production)
ALLOWED_ORIGINS=http://localhost
# Admin account created/reset at API startup (password: 12+ chars). No default admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Shared key IoT cold-chain sensors send in the x-device-key header
IOT_DEVICE_KEY=
# Use development for local previews. Use Stripe test credentials in staging.
NODE_ENV=production

# --- Database connection (defaults target the local docker-compose Postgres) --
# For Supabase use the Session pooler values from Dashboard > Connect, e.g.:
#   DB_HOST=aws-0-<region>.pooler.supabase.com  DB_PORT=5432
#   DB_USER=postgres.ftghshvmcjxkshoenpmn       DB_NAME=postgres
#   DB_SSL=true                                  DB_CONNECT_TIMEOUT_MS=10000
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_SSL=false
DB_SSL_CA_FILE=cloudflare/supabase-ca.crt
DB_CONNECT_TIMEOUT_MS=2000

# Cloudflare production uses the DATABASE Hyperdrive binding in wrangler.jsonc.
# No BACKEND_URL or Redis service is required on Cloudflare.
PUBLIC_APP_URL=https://nexora-ride-logistic.tanzeelsam.workers.dev

# Maps must support permanent geocoding; production bookings require road routes.
# Enable card payments only after Stripe sandbox and Connect onboarding tests.
CARD_PAYMENTS_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_COUNTRY=
# Web Push: generate using npx web-push generate-vapid-keys. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional independently validated dispatch service; the included baseline is not a trained model.
AI_DISPATCH_ENABLED=false

# Standalone Node only: comma-separated trusted proxy IPs/CIDRs. Empty rejects forwarded IPs.
TRUST_PROXY=
