FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nexora && adduser -S nexora -G nexora
COPY --from=builder /app/node_modules ./node_modules
COPY package.json backend_api.js ./
COPY cloudflare/passwords.cjs cloudflare/supabase-ca.crt ./cloudflare/
COPY frontend ./frontend
EXPOSE 3000
# Run as non-root user
USER nexora
CMD ["node", "backend_api.js"]
