FROM node:22.23.4-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM node:22.23.4-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nexora && adduser -S nexora -G nexora
COPY --from=builder /app/node_modules ./node_modules
COPY --chown=nexora:nexora package.json backend_api.js ./
COPY --chown=nexora:nexora cloudflare/passwords.cjs cloudflare/supabase-ca.crt ./cloudflare/
COPY --chown=nexora:nexora services ./services
COPY --chown=nexora:nexora supabase/migrations/20261019085513_booking_payments_notifications.sql ./supabase/migrations/
COPY --chown=nexora:nexora supabase/migrations/20261024093153_release_recovery_cash_billing.sql ./supabase/migrations/
COPY --chown=nexora:nexora supabase/migrations/20261024093804_durable_delivery_requests.sql ./supabase/migrations/
COPY --chown=nexora:nexora frontend ./frontend
EXPOSE 3000
# Run as non-root user
USER nexora
CMD ["node", "backend_api.js"]
