{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexora-ride-logistic",
  "account_id": "106f1cbc0fbab8fa5ecb3dd04baf2019",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/socket.io/*",
      "/track/*",
      "/health",
      "/ready",
      "/metrics"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "PUBLIC_APP_URL": "https://nexora-ride-logistic.tanzeelsam.workers.dev",
    "ALLOWED_ORIGINS": "https://nexora-ride-logistic.tanzeelsam.workers.dev,https://nexus-ride-logistic.tanzeelsam.workers.dev",
    "LOG_LEVEL": "warn"
  },
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "10d2564cb8f245839a13cad27b119496"
    }
  ]
}
